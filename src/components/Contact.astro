---
import { ButtonLink } from '@/components/ui/button';
import { copy, links, waLink, type Lang } from '@/i18n/copy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].contact;
const hero = copy[lang].hero;
const elsewhere = [
  { name: 'LinkedIn', href: links.linkedin },
  { name: 'GitHub', href: links.github },
  { name: 'Telegram', href: links.telegram },
  { name: 'TikTok', href: links.tiktok },
  { name: t.allLinks, href: '/pautan/' },
];
---

<footer id="contact" class="bg-navy text-white">
  <div class="shell grid gap-x-16 gap-y-12 py-20 md:grid-cols-12 md:py-28">
    <div class="md:col-span-7">
      <h2 class="heading text-[clamp(2rem,4.4vw,3.25rem)]">{t.title}</h2>
      <p class="mt-4 text-lg text-white/70">{t.lead}</p>
      <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
        <ButtonLink
          href={waLink(hero.waText)}
          target="_blank"
          rel="noopener"
          size="lg"
          className="bg-white text-navy hover:bg-mist">{t.whatsapp}</ButtonLink
        >
        <a
          href={links.email}
          class="label text-base text-white underline decoration-white/40 decoration-2 underline-offset-4 hover:decoration-white"
          >{t.email}</a
        >
      </div>
    </div>
    <div class="md:col-span-4 md:col-start-9">
      <h3 class="label text-white/60">{t.elsewhere}</h3>
      <ul class="mt-4 space-y-3">
        {
          elsewhere.map((l) => (
            <li>
              <a href={l.href} class="label text-base text-white hover:underline hover:underline-offset-4">
                {l.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="shell flex flex-wrap justify-between gap-x-8 gap-y-2 py-6 pb-28 text-sm text-white/60 md:pb-6">
      <p>© 2026 I Setel Solutions (SSM 202503352257). {t.rights}</p>
      <p>Klang, Selangor, Malaysia</p>
    </div>
  </div>
</footer>
