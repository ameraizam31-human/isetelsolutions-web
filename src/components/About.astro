---
import Founder from '@/components/Founder.astro';
import { copy, type Lang } from '@/i18n/copy';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = copy[lang].about;
---

<section id="about" class="bg-paper">
  <div class="shell grid gap-x-16 gap-y-12 py-20 md:grid-cols-12 md:py-28">
    <div class="md:col-span-7">
      <h2 class="heading text-[clamp(2rem,4.4vw,3.25rem)]">{t.title}</h2>
      <div class="mt-8 max-w-[38rem] space-y-5 text-slate">
        {t.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <dl class="self-end border-t border-line md:col-span-5">
      {
        t.facts.map((f) => (
          <div class="flex items-baseline justify-between gap-6 border-b border-line py-4">
            <dt class="text-slate">{f.k}</dt>
            <dd class="label text-right text-base text-navy">{f.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <Founder lang={lang} />
</section>
